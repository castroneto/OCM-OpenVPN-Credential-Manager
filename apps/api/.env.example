# OCM API configuration. Copy to .env for local development.
NODE_ENV=development
OCM_PORT=3000
# Interface to bind. Use 127.0.0.1 or the VPN NIC to limit exposure.
OCM_BIND_ADDR=0.0.0.0

# Directory of the built web console to serve (production single-service mode).
# Leave empty in dev — Vite serves the SPA and proxies /api.
OCM_WEB_ROOT=

# SQLite database file (better-sqlite3)
OCM_DATABASE_PATH=./data/ocm.sqlite

# JWT signing secret. MUST be >= 32 chars and unique per install.
# Generate: openssl rand -hex 32
OCM_JWT_SECRET=change-me-to-a-64-char-random-hex-string-generated-with-openssl
OCM_JWT_TTL_SECONDS=1800

# Login brute-force protection (per username, in-memory)
OCM_LOGIN_MAX_ATTEMPTS=5
OCM_LOGIN_LOCK_SECONDS=900

# OpenVPN / easy-rsa integration. OCM attaches to an existing OpenVPN server:
# point these at its PKI and configuration. It never creates a CA or a VPN.
OCM_OPENVPN_DIR=/etc/openvpn
OCM_PKI_DIR=/etc/openvpn/easy-rsa/pki
OCM_EASYRSA_BIN=/usr/share/easy-rsa/easyrsa

# Control channel of the managed server: tls-crypt | tls-auth | none.
# MUST match the server config - a tls-auth server rejects a tls-crypt profile.
OCM_TLS_MODE=tls-crypt
# Defaults to <OCM_OPENVPN_DIR>/ta.key when empty.
OCM_TLS_KEY_PATH=
# Base .ovpn template. Defaults to <OCM_OPENVPN_DIR>/client-template.ovpn.
OCM_CLIENT_TEMPLATE=

# CRL validity (days). The API regenerates the CRL on boot and weekly; this is
# a safety net so it never expires and locks out all clients.
OCM_CRL_DAYS=3650
