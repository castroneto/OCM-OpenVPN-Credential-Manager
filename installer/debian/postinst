#!/bin/sh
# OCM post-installation: attaches OCM to an already-running OpenVPN server.
# It never creates a CA, a server certificate or a VPN instance.
# The system starts with NO admin - create one with `ocm-admin create`.
set -e

. /usr/share/debconf/confmodule

OCM_HOME=/opt/ocm
OCM_ETC=/etc/ocm
OCM_DATA=/var/lib/ocm
OCM_USER=ocm
ENV_FILE="$OCM_ETC/ocm.env"
DROPIN_DIR=/etc/systemd/system/ocm-api.service.d

case "$1" in
  configure)
    # --- verify OpenVPN is already installed (do not install it) -----------
    if ! command -v openvpn >/dev/null 2>&1; then
      echo "ERROR: OpenVPN is not installed." >&2
      echo "OCM manages credentials for an existing OpenVPN server." >&2
      echo "Install it first:  sudo apt install openvpn" >&2
      exit 1
    fi

    # --- system user -------------------------------------------------------
    if ! getent passwd "$OCM_USER" >/dev/null; then
      adduser --system --group --home "$OCM_HOME" --no-create-home \
        --disabled-login --quiet "$OCM_USER"
    fi

    install -d -m 0750 -o "$OCM_USER" -g "$OCM_USER" "$OCM_DATA"
    install -d -m 0750 -o "$OCM_USER" -g "$OCM_USER" "$OCM_ETC"

    # --- gather debconf answers -------------------------------------------
    db_get ocm/pki_dir;     PKI_DIR="${RET:-/etc/openvpn/easy-rsa/pki}"
    db_get ocm/openvpn_dir; OPENVPN_DIR="${RET:-/etc/openvpn}"
    db_get ocm/vpn_host;    VPN_HOST="$RET"
    db_get ocm/http_port;   HTTP_PORT="${RET:-80}"
    db_get ocm/bind_addr;   BIND_ADDR="${RET:-127.0.0.1}"

    if [ -z "$VPN_HOST" ]; then
      VPN_HOST="$(hostname -I 2>/dev/null | awk '{print $1}')"
    fi

    # --- environment file (0640, owned by ocm) ----------------------------
    # Application settings only; the VPN paths are derived into openvpn.env by
    # setup-openvpn.sh. Kept across upgrades so the JWT secret stays stable.
    if [ ! -f "$ENV_FILE" ]; then
      JWT_SECRET="$(openssl rand -hex 32)"
      umask 027
      cat > "$ENV_FILE" <<EOF
NODE_ENV=production
OCM_PORT=$HTTP_PORT
OCM_BIND_ADDR=$BIND_ADDR
OCM_WEB_ROOT=$OCM_HOME/web
OCM_DATABASE_PATH=$OCM_DATA/ocm.sqlite
OCM_JWT_SECRET=$JWT_SECRET
OCM_JWT_TTL_SECONDS=1800
OCM_LOGIN_MAX_ATTEMPTS=5
OCM_LOGIN_LOCK_SECONDS=900
EOF
      chown "$OCM_USER":"$OCM_USER" "$ENV_FILE"
      chmod 0640 "$ENV_FILE"
    fi

    # --- attach to the existing OpenVPN deployment -------------------------
    OCM_PKI_DIR="$PKI_DIR" OCM_OPENVPN_DIR="$OPENVPN_DIR" \
      OCM_VPN_HOST="$VPN_HOST" OCM_ETC="$OCM_ETC" \
      sh "$OCM_HOME/installer/setup-openvpn.sh"

    # --- systemd: the PKI lives outside the unit's default ReadWritePaths --
    # ProtectSystem=full makes /etc read-only, so the adopted PKI must be
    # granted explicitly. Written here because the path is configurable.
    install -d -m 0755 "$DROPIN_DIR"
    cat > "$DROPIN_DIR/10-pki-path.conf" <<EOF
# Generated by the OCM package - do not edit; run \`dpkg-reconfigure ocm\`.
[Service]
ReadWritePaths=$PKI_DIR
EOF

    # --- database schema (no admin seeded) ---------------------------------
    su -s /bin/sh "$OCM_USER" -c \
      "cd $OCM_HOME/api && set -a && . $ENV_FILE && set +a && node dist/database/migrate.js"

    # --- service (NestJS serves both the API and the web console) ----------
    systemctl daemon-reload || true
    systemctl enable ocm-api.service >/dev/null 2>&1 || true
    systemctl restart ocm-api.service || true

    echo "-------------------------------------------------------------"
    echo " OCM installed - managing the OpenVPN server already on this host."
    echo "   PKI adopted : $PKI_DIR"
    echo "   Web console : http://$BIND_ADDR:$HTTP_PORT"
    if [ "$BIND_ADDR" = "127.0.0.1" ]; then
      echo "   (local only - tunnel in with:"
      echo "      ssh -L 8080:127.0.0.1:$HTTP_PORT root@$VPN_HOST )"
    fi
    echo ""
    echo " No administrator exists yet. Create the first one:"
    echo "     sudo ocm-admin create <username>"
    echo "-------------------------------------------------------------"

    db_stop || true
    ;;
esac

exit 0
