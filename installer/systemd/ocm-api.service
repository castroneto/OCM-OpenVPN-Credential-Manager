[Unit]
Description=OCM - OpenVPN Credential Manager API
After=network.target
Wants=network.target

[Service]
Type=simple
User=ocm
Group=ocm
WorkingDirectory=/opt/ocm/api
EnvironmentFile=/etc/ocm/ocm.env
ExecStartPre=/usr/bin/node dist/database/migrate.js
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/ocm /etc/openvpn/ocm
# Allow binding a privileged port (e.g. 80) as the unprivileged ocm user,
# since NestJS now serves the console directly (no nginx).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
