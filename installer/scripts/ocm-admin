#!/bin/sh
# ocm-admin — thin wrapper around the OCM admin CLI.
# Runs as the "ocm" service user so the database keeps consistent ownership.
set -e

CLI=/opt/ocm/cli/dist/main.js

for env_file in /etc/ocm/ocm.env /etc/ocm/openvpn.env; do
  if [ -f "$env_file" ]; then
    # shellcheck disable=SC1090
    set -a; . "$env_file"; set +a
  fi
done

if [ "$(id -u)" -eq 0 ] && getent passwd ocm >/dev/null 2>&1; then
  exec runuser -u ocm --preserve-environment -- /usr/bin/node "$CLI" "$@"
fi

exec /usr/bin/node "$CLI" "$@"
