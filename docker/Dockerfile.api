# syntax=docker/dockerfile:1
# OCM single-service image: NestJS API that also serves the built web console.
# Build context is the repo root.
FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.26.2 --activate
# Toolchain for better-sqlite3 native build.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY pnpm-workspace.yaml package.json ./
COPY apps/api ./apps/api
COPY apps/web ./apps/web
COPY apps/cli ./apps/cli
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @ocm/api build \
    && pnpm --filter @ocm/web build \
    && pnpm --filter @ocm/cli build
RUN pnpm --filter @ocm/api --legacy deploy --prod /app
# Bundle the static web console and the CLI into the deployed app.
# The CLI resolves better-sqlite3 from /app/node_modules (Node walks up).
RUN cp -r apps/web/dist /app/web && cp -r apps/cli/dist /app/cli

FROM node:22-bookworm-slim AS runtime
# easy-rsa + openvpn so the API can manage the PKI inside the container.
# gosu lets the entrypoint drop from root to the unprivileged ocm user.
RUN apt-get update && apt-get install -y --no-install-recommends \
    openvpn easy-rsa openssl gosu \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system ocm \
    && useradd --system --gid ocm --home-dir /app --no-create-home \
       --shell /usr/sbin/nologin ocm
WORKDIR /app
COPY --from=build /app ./
COPY docker/api-entrypoint.sh /usr/local/bin/ocm-entrypoint
RUN chmod +x /usr/local/bin/ocm-entrypoint
ENV NODE_ENV=production
ENV OCM_PORT=3000
ENV OCM_BIND_ADDR=0.0.0.0
ENV OCM_WEB_ROOT=/app/web
ENV OCM_DATABASE_PATH=/data/ocm.sqlite
ENV OCM_OPENVPN_DIR=/data/openvpn
ENV OCM_PKI_DIR=/data/openvpn/pki
EXPOSE 3000
CMD ["/usr/local/bin/ocm-entrypoint"]
